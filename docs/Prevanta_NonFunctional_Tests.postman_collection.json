{
  "info": {
    "_postman_id": "a7b4f8c2-91e4-4c62-8b3d-prevanta-nf-001",
    "name": "Prevanta Non-Functional Testing (Performance & Security)",
    "description": "Koleksi pengujian non-fungsional (Performance & Security) untuk REST API Prevanta (Laravel 13 + Sanctum). Jalankan dengan Collection Runner pada http://127.0.0.1:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "kader_token", "value": "" },
    { "key": "bidan_token", "value": "" },
    { "key": "ortu_token", "value": "" }
  ],
  "item": [
    {
      "name": "00 - Health Check (/api/ping)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{base_url}}/api/ping"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Respons < 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Login Kader (Simpan Token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"kader@prevanta.id\",\n  \"password\": \"password123\",\n  \"device_name\": \"postman-runner\"\n}"
        },
        "url": "{{base_url}}/api/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login Kader berhasil (200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "if (body.data && body.data.token) { pm.collectionVariables.set('kader_token', body.data.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - PERF-01 Dashboard Kader (Target <= 3000 ms)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{kader_token}}" }
        ],
        "url": "{{base_url}}/api/kader/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Waktu respons <= 3000 ms', () => pm.expect(pm.response.responseTime).to.be.at.most(3000));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - PERF-02 Monitoring Balita (Cek Paginasi & Latensi)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{kader_token}}" }
        ],
        "url": "{{base_url}}/api/kader/monitoring-balita"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Waktu respons <= 3000 ms', () => pm.expect(pm.response.responseTime).to.be.at.most(3000));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - SEC-01 Brute Force Login (Jalankan 20x di Runner)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"kader@prevanta.id\",\n  \"password\": \"password-salah-uji\"\n}"
        },
        "url": "{{base_url}}/api/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Percobaan berlebih seharusnya diblokir (429)', () => pm.expect(pm.response.code).to.be.oneOf([401, 429]));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - SEC-03 RBAC Lintas Peran (Kader -> Bidan Verifikasi)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{kader_token}}" }
        ],
        "url": "{{base_url}}/api/bidan/verifikasi"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ditolak 403 Forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - SEC-04 Akses Foto Profil Tanpa Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/media/profil-orangtua/iU1QWbdUUPjeKKkuhQjDpLXyz9cFY8xiI6NIw85R.jpg"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Seharusnya ditolak 401/403 (aktual 200 = celah)', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - SEC-05 SQL Injection Pencarian Monitoring",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{kader_token}}" }
        ],
        "url": "{{base_url}}/api/kader/monitoring-balita?search=' OR '1'='1' --"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 & tidak ada data bocor', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.balita.length).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
